# =============================================================================
# VNDesign Leads — variáveis de ambiente
# Copia para apps/web/.env.local (desenvolvimento) ou define-as no Vercel/Coolify.
# =============================================================================

# --- Supabase (Project Settings → API Keys) ----------------------------------
# Local (npx supabase start): http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
# Chave "publishable" (sb_publishable_…) ou a antiga "anon key". É pública.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxx

# Chave secreta (sb_secret_…) ou a antiga "service_role". NUNCA a expor no browser.
# Só é usada pelos scripts (npm run create-user) e, na Fase D, pela API de integração.
SUPABASE_SECRET_KEY=sb_secret_xxxxxxxxxxxxxxxx

# --- Testes E2E (Playwright) -------------------------------------------------
E2E_BASE_URL=http://localhost:3000
E2E_EMAIL=teste@vndesign.pt
E2E_PASSWORD=uma-palavra-passe-de-teste

# --- Fases seguintes (ainda não usadas) --------------------------------------
# PAGESPEED_API_KEY=          # Fase D — Google PageSpeed Insights
# CRON_SECRET=                # Fase C — resumo diário / lembretes
# ANTHROPIC_API_KEY=          # Fase E — gerador de email com IA
