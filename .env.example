# =============================================================================
# VNDesign Leads — variáveis de ambiente
# Copia para apps/web/.env.local (desenvolvimento) ou define-as no alojamento
# (Hostinger → Node.js → Variáveis de ambiente).
# Em produção NUNCA definir as variáveis marcadas "Só para testes".
# =============================================================================

# --- Supabase (Project Settings → API Keys) ----------------------------------
# Local (npx supabase start): http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
# Chave "publishable" (sb_publishable_…) ou a antiga "anon key". É pública.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxx

# Chave secreta (sb_secret_…) ou a antiga "service_role". NUNCA a expor no browser.
# Usada pelos scripts (npm run create-user), pelo cron e pelos tokens de integração (vnd_…).
SUPABASE_SECRET_KEY=sb_secret_xxxxxxxxxxxxxxxx

# --- Testes E2E (Playwright) -------------------------------------------------
E2E_BASE_URL=http://localhost:3000
E2E_EMAIL=teste@vndesign.pt
E2E_PASSWORD=uma-palavra-passe-de-teste

# --- Resumo diário por email (Fase C, opcional) ------------------------------
# SMTP da Hostinger (email @vndesign.pt): smtp.hostinger.com, porta 465.
# Em desenvolvimento, o Mailpit do Supabase local recebe tudo: SMTP_HOST=127.0.0.1,
# SMTP_PORT=54325, sem utilizador — os emails aparecem em http://127.0.0.1:54324
SMTP_HOST=
SMTP_PORT=465
# true = ligação cifrada desde o início (porta 465); a 587 usa STARTTLS. Por omissão: true se a porta for 465.
# SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
SMTP_FROM=VNDesign Leads <leads@vndesign.pt>
# Endereço público da plataforma (para os links nos emails). Em produção: https://leads.vndesign.pt
APP_URL=http://localhost:3000
# Segredo do endpoint /api/v1/cron/daily-digest (gera um valor aleatório longo)
CRON_SECRET=

# --- Auditor de sites (Fase D) -----------------------------------------------
# Chave gratuita do Google PageSpeed Insights (sem chave funciona, mas com limites
# baixos): https://developers.google.com/speed/docs/insights/v5/get-started
PAGESPEED_API_KEY=
# Só para testes: permite analisar sites em localhost / rede interna e salta o PageSpeed.
# AUDIT_ALLOW_PRIVATE=1
# AUDIT_SKIP_PAGESPEED=1

# --- Notificações push / PWA (Fase D, opcional) ------------------------------
# Gera uma vez com:  npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:geral@vndesign.pt

# --- Email com IA (Fase E, opcional) ----------------------------------------
# Chave da API da Anthropic (console.anthropic.com → API Keys). Só no servidor.
ANTHROPIC_API_KEY=
# Modelo (opcional; por omissão claude-opus-5-5)
# ANTHROPIC_MODEL=claude-opus-5-5
# Só para testes: servidor falso da API (e2e/stubs.ts)
# AI_BASE_URL=http://127.0.0.1:4621

# --- Mapa (Fase E) -----------------------------------------------------------
# Por omissão usa o OpenStreetMap (Nominatim), gratuito, 1 pesquisa por segundo.
# Só para testes: servidor falso (e2e/stubs.ts). Sem pausa só em 127.0.0.1/localhost.
# GEOCODER_URL=http://127.0.0.1:4620/search
